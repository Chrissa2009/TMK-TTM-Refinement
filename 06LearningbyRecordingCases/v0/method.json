{
  "model": "Method",
  "methods": [
    {
      "name": "RecordingCasesSolution",
      "description": "FSM for solving a new problem by recording and retrieving similar cases.",
      "inputParameters": [
        "initialConfiguration: configuration",
        "caseMemory: caseMemory"
      ],
      "outputParameters": [
        "finalConfiguration: configuration"
      ],
      "organizer": {
        "startState": "S0",
        "successState": "S4_Complete",
        "failureState": "S_Fail",
        "states": [
          {
            "name": "S0",
            "goalInvocation": {
              "goalReference": "RepresentProblem",
              "type": "task",
              "actualArguments": [
                "initialConfiguration"
              ]
            }
          },
          {
            "name": "S1",
            "goalInvocation": {
              "goalReference": "ComputeSimilarity",
              "type": "task",
              "actualArguments": [
                "problemRepresentation",
                "caseMemory"
              ]
            }
          },
          {
            "name": "S2",
            "goalInvocation": {
              "goalReference": "RetrieveNearestCase",
              "type": "task",
              "actualArguments": [
                "distanceSet"
              ]
            }
          },
          {
            "name": "S3",
            "goalInvocation": {
              "goalReference": "ApplyCaseSolution",
              "type": "task",
              "actualArguments": [
                "retrievedCase",
                "initialConfiguration"
              ]
            }
          },
          {
            "name": "S4_Complete",
            "goalInvocation": {
              "goalReference": "Complete",
              "type": "task",
              "actualArguments": []
            }
          },
          {
            "name": "S_Fail",
            "goalInvocation": {
              "goalReference": "FailureGoal",
              "type": "task",
              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "S0",
            "targetState": "S1",
            "dataCondition": "!isEmpty(problemRepresentation)"
          },
          {
            "sourceState": "S1",
            "targetState": "S2",
            "dataCondition": "!isEmpty(distanceSet)"
          },
          {
            "sourceState": "S2",
            "targetState": "S3",
            "dataCondition": "!isEmpty(retrievedCase)"
          },
          {
            "sourceState": "S3",
            "targetState": "S4_Complete",
            "dataCondition": "goodCaseRetrieval(finalConfiguration)"
          },
          {
            "sourceState": "S0",
            "targetState": "S_Fail",
            "dataCondition": "isEmpty(problemRepresentation)"
          },
          {
            "sourceState": "S1",
            "targetState": "S_Fail",
            "dataCondition": "isEmpty(distanceSet)"
          },
          {
            "sourceState": "S2",
            "targetState": "S_Fail",
            "dataCondition": "isEmpty(retrievedCase)"
          },
          {
            "sourceState": "S3",
            "targetState": "S_Fail",
            "dataCondition": "!goodCaseRetrieval(finalConfiguration)"
          }
        ]
      }
    },
    {
      "name": "RepresentProblemMechanism",
      "description": "Represents a problem in a feature space such as width and height coordinates.",
      "inputParameters": [
        "initialConfiguration: configuration"
      ],
      "outputParameters": [
        "problemRepresentation: problemRepresentation"
      ]
    },
    {
      "name": "ComputeSimilarityMechanism",
      "description": "Computes distances between the new problem and recorded cases using Euclidean distance.",
      "inputParameters": [
        "problemRepresentation: problemRepresentation",
        "caseMemory: caseMemory"
      ],
      "outputParameters": [
        "distanceSet: distanceSet"
      ]
    },
    {
      "name": "RetrieveNearestCaseMechanism",
      "description": "Retrieves the nearest case or k-nearest neighbors from memory.",
      "inputParameters": [
        "distanceSet: distanceSet"
      ],
      "outputParameters": [
        "retrievedCase: recordedCase"
      ]
    },
    {
      "name": "ApplyCaseSolutionMechanism",
      "description": "Transfers the solution associated with the retrieved case to the current problem.",
      "inputParameters": [
        "retrievedCase: recordedCase",
        "initialConfiguration: configuration"
      ],
      "outputParameters": [
        "finalConfiguration: configuration"
      ]
    },
    {
      "name": "Assertions",
      "description": "Logical mappings used in learning by recording cases.",
      "inputParameters": [],
      "outputParameters": [],
      "assertions": [
        {
          "name": "nearestNeighbor",
          "description": "Returns the most similar case to a new problem.",
          "equivalentTo": "RetrieveNearestCaseMechanism"
        },
        {
          "name": "kNearestNeighbor",
          "description": "Returns the nearest cases in a multidimensional feature space.",
          "equivalentTo": "RetrieveNearestCaseMechanism"
        }
      ]
    }
  ]
}